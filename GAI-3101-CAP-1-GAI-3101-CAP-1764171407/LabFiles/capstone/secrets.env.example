# BeanBotics Agent Configuration
# ================================
# Copy this file to secrets.env and fill in your values:
#   cp secrets.env.example secrets.env
#
# Then edit secrets.env with your actual API key.
# Do NOT commit secrets.env to version control!

# OpenAI API Key (required)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model (optional)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Default: gpt-4o
OPENAI_MODEL=gpt-4o

# Ticketing System API URL (optional)
# Default: http://localhost:3000
TICKETING_API_URL=http://localhost:3000